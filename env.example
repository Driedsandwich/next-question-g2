# Next Question server settings. Copy to `.env` (git-ignored) and fill in only what you use.
# Names only. Never commit real values.

# Where questions come from: replay (fictional AMA, default, no network) | telegram
QUESTION_SOURCE=replay
# Telegram (only when QUESTION_SOURCE=telegram). Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional: only use this group (numeric chat id). Empty = the group where the presenter runs /ama_start.
TELEGRAM_CHAT_ID=
# Optional: numeric Telegram user id of the presenter. Empty = pair with /pair <code> in a private chat.
TELEGRAM_PRESENTER_ID=

# Merging similar questions: rules (offline, default) | openai-compatible (falls back to rules on any error)
MERGER=rules
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Speech-to-text for the hold-to-speak answer: none (default) | openai-compatible
STT=none
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

PORT=8788
DATA_DIR=
# Replay pacing: 1 = real fixture time (about 2.5 min for all questions), 4 = four times faster
REPLAY_SPEED=1
REPLAY_SESSION_MIN=30
